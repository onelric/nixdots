(defwindow bar 
        :monitor "eDP-1"
        :geometry (geometry :x "5px" :y "5px"
                            :width "99%" :height "38px"
                            :anchor "top center")
        :windowtype "dock"
        :stacking "fg"
        :exclusive true
        :focusable false
        (bar)
)

(defvar playerctl-clicked-open false)
(defvar systray-clicked-open false)
(defvar bar-stats-clicked-open false)
(defwidget playerctl[]
    (box :space-evenly "false" :orientation "h" :valign "center" :class "module"
        (box :space-evenly "false" :orientation "h" :valign "center" :class "module"
            (button 
                    :onclick "eww update playerctl-clicked-open=$( [ \"$(eww get playerctl-clicked-open)\" = \"true\" ] && echo false || echo true )"
                (label :text "" :class "bar-player-icon")
            )

            (revealer :transition "slideleft" :reveal playerctl-clicked-open :duration "250ms"
                (box :orientation "v" :space-evenly false
                    (box :space-evenly "false"
                        (label
                            :text { playerctl-isplaying == "true"
                                ? "${playerctl-title} ~ ${playerctl-artist}"
                                : "no music is playing"
                            }
                            :class "playerctl-title-bar"
                        )
                    )
                )
            )
        )

        (box :space-evenly "false" :orientation "h" :valign "center" :class "module"
            (button 
                    :onclick "eww update bar-stats-clicked-open=$( [ \"$(eww get bar-stats-clicked-open)\" = \"true\" ] && echo false || echo true )"
                (label :text "󰒓" :class "bar-player-icon")
            )

            (revealer :transition "slideright" :reveal bar-stats-clicked-open :duration "250ms"
                (box :orientation "h" :space-evenly false
                        (label :text "  ${cpu-temp},   ${cpu-avg},   ${ram-usage}")
                )
            )
        )

        (box :space-evenly "false" :orientation "h" :valign "center" :class "module"
            (button 
                    :onclick "eww update systray-clicked-open=$( [ \"$(eww get systray-clicked-open)\" = \"true\" ] && echo false || echo true )"
                (label :text "󰀻" :class "bar-player-icon")
            )

            (revealer :transition "slideright" :reveal systray-clicked-open :duration "250ms"
                (systray :icon-size 16)
            )
        )
    )
)

(defwidget time[]
    (box :class "module" :space-evenly "false"
        (label :text "󰥔" :class "bar-clock-icon")
        (label :text "${hour}:${min}:${sec}")
    )
)

(defwidget date[]
    (box :class "module" :valign "center" :space-evenly "false"
        (label :text "󰃵" :class "bar-calendar-icon")
        (label :text "${day} ${month} ${year}")
    )
)

(defwidget sound[]
    (box :class "module" :space-evenly "false"
        (label :class "bar-volume-icon" :halign "start" :text volume-level-icon)
        (scale 
            :class "bar-volume-scale"
            :hexpand "true"
            :min "0" :max "101"
            :onchange "pamixer --set-volume {}"
            :halign "end"
            :valign "center"
            :value current-volume)
        )
)

(defwidget info-collection[]
    (box :space-evenly "false" :orientation "h" :valign "center" :class "module" :spacing 8
        (circular-progress 
            :class "bar-circle-progress-battery"
            :hexpand true
            :vexpand true
            :thickness 2.5
            :start-at 25
            :width 15
            :value current-battery  
            (label :class "bar-circle-progress-label" :text "  ")
        )
        (label :class "bar-circle-progress-label" :text "${current-battery}%")
        (circular-progress 
            :class "bar-circle-progress-brightness"
            :hexpand true
            :vexpand true
            :thickness 2.5
            :start-at 25
            :width 15
            :value current-brightness  
            (label :class "bar-circle-progress-label" :text "  ")
        )
        (label :class "bar-circle-progress-label" :text "${current-brightness}%")
    )
)



(defwidget wifi[]
    (box :orientation "h" :space-evenly false :valign "center" :class "module"
        (label :class "bar-network-icon" :text network-status)

        (revealer :transition "slideleft" :reveal network-isconnected :duration "250ms"
            (label :class "bar-network-ssid" :text network-ssid)
        )
    )
)

(defwidget bar[]
    (centerbox
        :orientation "h"
        :class "bar"

        (box :class "left-modules" :halign "start" :space-evenly "false"
            (button :onclick "eww open power_menu --toggle"
                (label :class "bar-control-centre" :text "")
            )
            (box (info-collection))
            (box (sound))
        )

        (box :class "center-modules" :halign "center"
            (box :space-evenly "false" :orientation "h" (playerctl))
        )

        (box :class "right-modules" :halign "end" :space-evenly "false"
            (box :space-evenly "false" :orientation "h" :halign "end" (time))
            (box :space-evenly "false" :orientation "h" :halign "end" (date))
            (box :space-evenly "false" :orientation "h" :halign "end" (wifi))
        )
    )
)
